# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env lên git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=san_bong
DB_USER=root
DB_PASS=
# Hiện chi tiết exception trong response. Chỉ bật khi phát triển, không bật trên môi trường public.
APP_DEBUG=false
# HMAC secret configured for your SePay webhook (keep private).
SEPAY_WEBHOOK_SECRET=
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
NOTIFICATION_WS_SECRET=
# Use wss://<second-ngrok-domain> when publishing over HTTPS.
NOTIFICATION_WS_URL=ws://localhost:3001
# Create a second tunnel with: ngrok http 3001
# Optional additional strict allowlist (comma-separated exact browser origins).
NOTIFICATION_WS_ALLOWED_ORIGINS=
NOTIFICATION_WS_PORT=3001
